# Certificates and keys are never committed (ADR-004). Dev material is
# generated by scripts/gen-dev-certs.sh; prod material is supplied out of band.
*.key
*.pem
# The fuzz target tls_client pins this public, self-signed test CA (CN=fuzz CA, no key) with include_bytes!.
!fuzz/fuzz_targets/tls_client_ca.pem
*.srl
*.csr
deploy/bench-*/
deploy/netcup/
deploy/*/devices/
deploy/*/negative/
deploy/*/services/
deploy/*/bootstrap/
deploy/*/control.pub
deploy/*/revoked.txt

.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc

# The public demo broker's generated certificates (scripts/demo-certs.sh, D1); never committed.
deploy/demo/pki/
